<!--
  Headless syntax and type check for Assets/Scripts, with no Unity install required.

  UnityStubs.cs and NetcodeStubs.cs declare the SHAPE of the UnityEngine and
  Netcode-for-GameObjects APIs the game touches - signatures only, no behaviour.
  Compiling the real gameplay scripts against them catches typos, bad overloads,
  wrong types and broken overrides in seconds.

  It does NOT replace opening the project: it cannot verify NGO's IL
  post-processing (RPC codegen, NetworkVariable registration), nor anything about
  runtime behaviour, rendering or replication.

      bash tools/compilecheck/run.sh
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- CS0649: [SerializeField] fields are assigned by Unity's serializer, not by C#. -->
    <NoWarn>CS0067;CS0649;CS0108;CS0114;CS0660;CS0661</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="UnityStubs.cs" />
    <Compile Include="NetcodeStubs.cs" />
    <Compile Include="../../Assets/Scripts/**/*.cs" />
  </ItemGroup>
</Project>
